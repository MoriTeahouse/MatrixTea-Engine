<Window x:Class="MatrixTea.Editor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MatrixTea.Editor" Title="MatrixTea Studio · 可視化編輯器 0.1 測試版" Width="1440" Height="920" MinWidth="1100" MinHeight="720" Icon="Assets/engine-icon.png" WindowStartupLocation="CenterScreen" Background="#0E1B24" Foreground="#EEE7D9" FontFamily="Segoe UI, Microsoft JhengHei" FontSize="14">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="48" /></Grid.RowDefinitions>
    <Grid><StackPanel Orientation="Horizontal"><Image Source="Assets/engine-icon.png" Width="54" Height="54" Margin="0,0,16,0" /><StackPanel VerticalAlignment="Center"><TextBlock Text="MATRIXTEA STUDIO" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="森之宿茶室 · 地圖 / 任務 / 四軌譜面" Foreground="#98DFBC" Margin="0,5,0,0" /></StackPanel></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="可視化編輯器 · 首個測試版本" Foreground="#E4B36C" HorizontalAlignment="Right" /><TextBlock x:Name="ProjectTitle" FontSize="16" Margin="0,6,0,0" HorizontalAlignment="Right" /></StackPanel></Grid>
    <DockPanel Grid.Row="1"><StackPanel Orientation="Horizontal"><Button Content="＋ 新專案" Click="New_Click" /><Button Content="開啟" Click="Open_Click" /><Button Content="儲存  Ctrl+S" Click="Save_Click" /><Button x:Name="UndoButton" Content="↶ 復原" Click="Undo_Click" /><Button x:Name="RedoButton" Content="↷ 重做" Click="Redo_Click" /><Button Content="匯出 .atr" Click="Export_Click" /></StackPanel><Button x:Name="PlayButton" Content="▶ 遊玩預覽" Click="Play_Click" HorizontalAlignment="Right" Background="#365E50" /></DockPanel>
    <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="245" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="285" /></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="專案探索" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,15" /><TextBlock Text="場景" Foreground="#98DFBC" /><ComboBox x:Name="Scenes" SelectionChanged="Scenes_Changed" DisplayMemberPath="Name" /><Button Content="新增場景" Click="AddScene_Click" /></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,14,0,4"><TextBlock Text="繪製工具" Foreground="#98DFBC" /><ComboBox x:Name="BrushSelector" SelectedIndex="0"><ComboBoxItem Content="選取物件" /><ComboBoxItem Content="草地" /><ComboBoxItem Content="石牆" /><ComboBoxItem Content="水面" /><ComboBoxItem Content="石徑" /><ComboBoxItem Content="花草" /></ComboBox><TextBlock Text="拖曳繪製 · 每次筆畫可整筆復原" FontSize="11" Foreground="#A7BABC" TextWrapping="Wrap" /></StackPanel>
        <TextBlock Grid.Row="2" Text="場景物件" Foreground="#98DFBC" Margin="0,20,0,10" />
        <ListBox Grid.Row="3" x:Name="Entities" SelectionChanged="Entities_Changed" />
        <StackPanel Grid.Row="4" Margin="0,12,0,0"><ComboBox x:Name="NewEntityKind" SelectedIndex="0"><ComboBoxItem Content="訪客 Guest" /><ComboBoxItem Content="入口 Door" /><ComboBoxItem Content="素材 Resource" /><ComboBoxItem Content="聲音 Sound" /></ComboBox><Button Content="＋ 放置物件" Click="AddEntity_Click" /></StackPanel>
      </Grid></Border>
      <Border Grid.Column="2" Background="#0B161E" CornerRadius="12" Padding="12"><TabControl x:Name="Workspace" Background="#0B161E" BorderThickness="0" SelectionChanged="Workspace_Changed">
        <TabItem Header="庭園地圖"><Grid Background="#0B161E"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="54" /></Grid.RowDefinitions><local:SceneView x:Name="MapView" Margin="10" /><TextBlock Grid.Row="1" x:Name="MapHint" Text="選取物件編輯屬性，或選擇地形後拖曳繪製。預覽：WASD 移動 · Shift 跑步 · E 互動 · Esc 停止" Foreground="#A7BABC" TextWrapping="Wrap" Margin="10" /></Grid></TabItem>
        <TabItem Header="四軌譜面"><Grid Background="#0B161E"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><DockPanel Margin="10"><Button Content="匯入音樂 WAV / MP3" Click="Audio_Click" /><TextBlock x:Name="AudioLabel" Foreground="#98DFBC" VerticalAlignment="Center" Margin="10,0" Text="無音樂 · 使用節拍時間軸" TextTrimming="CharacterEllipsis" /></DockPanel><local:ChartView Grid.Row="1" x:Name="Timeline" Margin="18,8" /><StackPanel Grid.Row="2" Margin="12"><TextBlock Text="左鍵新增／切換音符 · 右鍵移除 · 1/16 拍吸附 · 預覽按 D F J K" Foreground="#A7BABC" /><Slider x:Name="TimeScroll" Minimum="0" ValueChanged="TimeScroll_Changed" Margin="0,12" /><TextBlock x:Name="ChartStats" Foreground="#98DFBC" /></StackPanel></Grid></TabItem>
        <TabItem Header="任務關係"><Grid Background="#0B161E" Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="建立任務與前置關係，循環與遺失參照會在套用前攔截。" Foreground="#98DFBC" TextWrapping="Wrap" Margin="0,10,0,20" /><ListBox Grid.Row="1" x:Name="Quests" SelectionChanged="Quests_Changed" /><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"><Button Content="＋ 新增任務" Click="AddQuest_Click" /><Button Content="刪除選取任務" Click="DeleteQuest_Click" /></StackPanel></Grid></TabItem>
      </TabControl></Border>
      <Border Grid.Column="4" Background="{StaticResource Panel}" CornerRadius="12" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="屬性檢查器" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,20" /><TextBlock Text="專案名稱" Foreground="#98DFBC" /><TextBox x:Name="NameInput" /><TextBlock Text="場景名稱" /><TextBox x:Name="SceneNameInput" /><Button Content="套用名稱" Click="Names_Click" />
        <StackPanel x:Name="EntityInspector" Margin="0,22,0,0"><TextBlock Text="選取物件" Foreground="#E4B36C" FontWeight="SemiBold" /><TextBlock Text="名稱" Margin="0,10,0,0" /><TextBox x:Name="EntityName" /><TextBlock Text="位置 X / Y（格）" /><UniformGrid Columns="2"><TextBox x:Name="EntityX" Margin="0,4,5,10" /><TextBox x:Name="EntityY" Margin="5,4,0,10" /></UniformGrid><TextBlock Text="對話 / 互動文字" /><TextBox x:Name="EntityDialogue" Height="85" AcceptsReturn="True" TextWrapping="Wrap" /><TextBlock Text="完成任務 ID（可空白）" /><TextBox x:Name="EntityQuest" /><Button Content="套用物件" Click="ApplyEntity_Click" /><Button Content="刪除物件" Click="DeleteEntity_Click" /></StackPanel>
        <StackPanel x:Name="ChartInspector" Visibility="Collapsed" Margin="0,22,0,0"><TextBlock Text="譜面設定" Foreground="#E4B36C" /><TextBlock Text="BPM（30–300）" Margin="0,12,0,0" /><TextBox x:Name="BpmInput" /><TextBlock Text="曲長（秒，最長 600）" /><TextBox x:Name="DurationInput" /><TextBlock Text="判定偏移（毫秒）" /><TextBox x:Name="OffsetInput" /><Button Content="套用譜面設定" Click="ApplyChart_Click" /><Button Content="移除音樂參照" Click="ClearAudio_Click" /></StackPanel>
        <StackPanel x:Name="QuestInspector" Visibility="Collapsed" Margin="0,22,0,0"><TextBlock Text="選取任務" Foreground="#E4B36C" /><TextBlock Text="ID" Margin="0,12,0,0" /><TextBox x:Name="QuestIdInput" /><TextBlock Text="標題" /><TextBox x:Name="QuestTitleInput" /><TextBlock Text="前置任務 ID（逗號分隔）" /><TextBox x:Name="QuestRequires" /><Button Content="套用任務" Click="ApplyQuest_Click" /></StackPanel>
        <TextBlock Text="MoriTeahouse · AGPL-3.0-only" FontSize="11" Foreground="#78979C" Margin="0,26,0,0" />
      </StackPanel></ScrollViewer></Border>
    </Grid>
    <TextBlock Grid.Row="3" x:Name="Status" Foreground="#98DFBC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
  </Grid>
</Window>
